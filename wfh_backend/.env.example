# Server config
HOST=localhost
PORT=5000
JWT_SECRET=replace_with_a_long_random_secret
CORS_ORIGIN=*

# Database config
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_NAME=WFH_database

# Prisma database url connection string
DATABASE_URL=postgresql://postgres:your_db_password_here@localhost:5432/WFH_database

# Branding (served to frontend via GET /api/config)
COMPANY_NAME=WFH Portal
APP_SUBTITLE=Workforce Monitoring & Productivity Platform

# Shift / compliance rules (no frontend hardcoding)
AUTO_CLOCK_OUT_HOURS=8.5
HALF_DAY_HOURS=4.0
TASK_ASSIGN_MINUTES=30
SCREENSHOT_INTERVAL_MINUTES=30
SHORT_BREAK_LIMIT=3
SHORT_BREAK_MINUTES=15
LUNCH_BREAK_MINUTES=45
LUNCH_UNLOCK_HOUR=13
IDLE_TIMEOUT_MINUTES=7
BACKGROUND_HIDDEN_TIMEOUT_MINUTES=7
BREAK_GRACE_SECONDS=15
SCREENSHOT_RETENTION_DAYS=7
ADMIN_SCREENSHOT_WINDOW_HOURS=24
SHIFT_HISTORY_LIMIT=30
